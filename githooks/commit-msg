#!/usr/bin/env bash

# Cross-platform safety: only enforce if commitizen is available
if command -v cz >/dev/null 2>&1; then
  cz check --commit-msg-file "$1"
  exit $?
fi

# Fallback: use python only if commitizen is installed
python - "$1" <<'PY'
import sys, importlib.util, subprocess
msgfile = sys.argv[1]
spec = importlib.util.find_spec('commitizen')
if spec is None:
    print('[commit-msg] commitizen 未安装，跳过严格校验。建议: pip install commitizen')
    sys.exit(0)

rc = subprocess.call([sys.executable, '-m', 'commitizen', 'check', '--commit-msg-file', msgfile])
sys.exit(rc)
PY

